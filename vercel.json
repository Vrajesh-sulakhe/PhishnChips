{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "frontend",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://139.84.159.12.sslip.io/api/:path*"
    },
    {
      "source": "/metrics",
      "destination": "https://139.84.159.12.sslip.io/metrics"
    }
  ]
}
