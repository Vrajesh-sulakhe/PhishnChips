# Phish&Chips Environment Configuration

# Vultr Serverless Inference (Multimodal & LLM Analysis)
VULTR_INFERENCE_API_KEY=your_vultr_inference_api_key_here
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
VULTR_MODEL=llama2-13b-chat

# Google OAuth 2.0 Credentials (Identity Services & Sign-In)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Runtime Guardrails & Isolation Limits
# End-to-end budget (sandbox + parse + inference). On expiry the verdict is INDETERMINATE, never Malicious.
TOTAL_BUDGET_SECONDS=20
# Sandbox container wall-clock cap (must be < TOTAL_BUDGET_SECONDS)
SCAN_TIMEOUT_SECONDS=14
MAX_QUEUE_DEPTH=50
# Reputation gate list (Tranco top-N) - user-content hosts are always excluded
REPUTATION_TOP_N=10000
MAX_CONCURRENT_SCANS=3
JOB_RETENTION_MINUTES=30


