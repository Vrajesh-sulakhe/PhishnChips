[Unit]
Description=Phish&Chips Ephemeral Detonation Backend (Track 01: Blast Radius Zero)
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/phish-n-chips/backend
EnvironmentFile=-/root/phish-n-chips/.env
ExecStart=/root/phish-n-chips/backend/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
